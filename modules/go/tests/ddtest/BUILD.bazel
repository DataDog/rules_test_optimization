    name = "recursive_args_native_test",
    srcs = ["recursive_args_test.go"],
    args = [
        "$(DATA_ARG)",
        "'$$(literal)'",
    ],
    data = [":public_data.txt"],
    tags = ["manual"],
    deps = ["@io_bazel_rules_go//go/runfiles"],
)

dd_topt_go_test(
    name = "recursive_args_wrapped_test",
    srcs = ["recursive_args_test.go"],
    args = [
        "$(DATA_ARG)",
        "'$$(literal)'",
    ],
    data = [":public_data.txt"],
