load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_cross_binary", "go_library")
load("//:topt_go_stdlib.bzl", "dd_topt_go_stdlib_warmup")
load("//:topt_go_test.bzl", "dd_topt_go_test")
load("//tests:test_macro.bzl", "stdlib_warmup_target_has_outputs_test")
load(
    ":fixtures.bzl",
    "TOPT_DATA",
    "ddtest_transition_test",
    "foreign_mini_failure_test",
)

# Runs instrumented: it fails unless Mini set its context's trace. Its deps
# name testopt, which the macro then adds only once; its external test
# package receives the registration.
dd_topt_go_test(
    name = "instrumented_test",
    srcs = [
        "external_test.go",
        "instrumented_test.go",
    ],
    importpath = "example.com/ddtestfixture",
    topt_data = TOPT_DATA,
    deps = [
        "@topt_go_ddtest_mini//propagation",
        "@topt_go_ddtest_mini//testopt",
    ],
)

# Its configurable deps already name testopt, which the macro adds through an
# alias.
dd_topt_go_test(
    name = "select_deps_test",
    srcs = [
        "external_test.go",
        "instrumented_test.go",
    ],
    importpath = "example.com/selectfixture",
    topt_data = TOPT_DATA,
    deps = select({
        "//conditions:default": [
            "@topt_go_ddtest_mini//propagation",
            "@topt_go_ddtest_mini//testopt",
        ],
    }),
)

# Its only source comes through embed, which the registration also reads.
go_library(
    name = "widget",
    srcs = ["widget.go"],
    importpath = "example.com/widget",
)

dd_topt_go_test(
    name = "embed_only_test",
    embed = [":widget"],
    topt_data = TOPT_DATA,
)

# Keep legacy-only syntax in a generated file so gofmt cannot add //go:build.
genrule(
    name = "legacy_ignored_generator",
    outs = ["legacy_ignored_generator.go"],
    cmd = "printf '// +build ignore\\n\\npackage main\\n' > $@",
)

# The active source has a negated constraint; the generator is always excluded.
dd_topt_go_test(
    name = "constrained_test",
    srcs = [
        "constrained_test.go",
        ":legacy_ignored_generator",
    ],
    importpath = "example.com/constrained",
    topt_data = TOPT_DATA,
)

# A copy of Mini's packages from another repository stops analysis.
dd_topt_go_test(
    name = "foreign_mini_test",
    srcs = ["foreign_test.go"],
    importpath = "example.com/foreign",
    tags = ["manual"],
    topt_data = TOPT_DATA,
    deps = ["//tests/ddtest/fake_mini"],
)

foreign_mini_failure_test(
    name = "foreign_mini_failure_test",
    target_under_test = ":foreign_mini_test",
)

ddtest_transition_test(name = "ddtest_transition_test")

# Go binaries below an instrumented test build with the SDK that their
# sdk_version selects: unset or a prefix of the default SDK's version, or an
# SDK variant that the companion's MODULE.bazel configures. Each case has its
# own go_binary, whose runfiles path the other configurations would share.
# The cross binaries are manual because outside the test no regular SDK
# serves their sdk_version.
go_binary(
    name = "go_version_tool",
    srcs = ["go_version_tool.go"],
)

go_binary(
    name = "go_version_tool_for_1_26",
    srcs = ["go_version_tool.go"],
    tags = ["manual"],
)

go_cross_binary(
    name = "go_version_tool_1_26",
    sdk_version = "1.26",
    tags = ["manual"],
    target = ":go_version_tool_for_1_26",
)

go_binary(
    name = "go_version_tool_for_fips",
    srcs = ["go_version_tool.go"],
    tags = ["manual"],
)

go_cross_binary(
    name = "go_version_tool_fips",
    sdk_version = "1.25.9fips",
    tags = ["manual"],
    target = ":go_version_tool_for_fips",
)

# An exec tool that imports testing builds with the instrumented SDK too.
go_binary(
    name = "testing_tool",
    srcs = ["testing_tool.go"],
)

genrule(
    name = "testing_tool_output",
    outs = ["testing_tool_output.txt"],
    cmd = "$(execpath :testing_tool) > $@",
    tools = [":testing_tool"],
)

dd_topt_go_test(
    name = "sdk_variants_test",
    srcs = ["sdk_variants_test.go"],
    data = [
        ":go_version_tool",
        ":go_version_tool_1_26",
        ":go_version_tool_fips",
        ":testing_tool_output",
    ],
    env = {
        "GO_VERSION_TOOL": "$(rlocationpath :go_version_tool)",
        "GO_VERSION_TOOL_1_26": "$(rlocationpath :go_version_tool_1_26)",
        "GO_VERSION_TOOL_FIPS": "$(rlocationpath :go_version_tool_fips)",
        "TESTING_TOOL_OUTPUT": "$(rlocationpath :testing_tool_output)",
    },
    topt_data = TOPT_DATA,
    deps = ["@io_bazel_rules_go//go/runfiles"],
)

# The standard library that instrumented tests build, warmed on its own.
dd_topt_go_stdlib_warmup(name = "stdlib_warmup")

stdlib_warmup_target_has_outputs_test(
    name = "stdlib_warmup_has_outputs_test",
    target_under_test = ":stdlib_warmup",
)
