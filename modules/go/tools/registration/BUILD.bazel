load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "registration_lib",
    srcs = ["main.go"],
    importpath = "github.com/DataDog/rules_test_optimization/modules/go/tools/registration",
    visibility = ["//visibility:private"],
)

# Writes the registration file of instrumented Go tests.
go_binary(
    name = "registration",
    embed = [":registration_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "registration_test",
    srcs = ["main_test.go"],
    embed = [":registration_lib"],
)
