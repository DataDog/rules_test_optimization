+	if err := os.WriteFile(filepath.Join(cacheDir, orchestrionStdlibCacheManifestName), []byte("os=os-cache.a\n"), 0o644); err != nil {
+		t.Fatalf("write cache manifest: %v", err)
+	}
+
+	goenv := &env{
