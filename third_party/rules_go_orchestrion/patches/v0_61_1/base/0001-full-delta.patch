+package tools
+
+import (
+    _ "github.com/DataDog/orchestrion"
+    _ "github.com/DataDog/dd-trace-go/contrib/log/slog/v2"
+    _ "github.com/DataDog/dd-trace-go/contrib/net/http/v2"
