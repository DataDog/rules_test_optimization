+        result = _ctx_execute_checked(
+            ctx,
+            [str(powershell), "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", command],
+            timeout = 120,
+        )
+    else:
+        shell = ctx.which("sh") or "/bin/sh"
