+func incompleteModulePackageMetadataError(pkg string, meta modulePackageMetadata, stderr string) error {
+	message := fmt.Sprintf(
+		"incomplete package metadata (Dir=%q ImportPath=%q GoFiles=%d)",
+		meta.Dir,
+		meta.ImportPath,
+		len(meta.GoFiles),
+	)
+	return modulePackageError(pkg, message, stderr)
