+func modulePackageError(pkg, message, stderr string) error {
+	stderr = strings.TrimSpace(stderr)
+	if stderr == "" {
+		return fmt.Errorf("%s for %s", message, pkg)
+	}
+	return fmt.Errorf("%s for %s\n%s", message, pkg, stderr)
+}
