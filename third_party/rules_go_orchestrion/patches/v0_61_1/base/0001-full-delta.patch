+def _dd_trace_go_versions_json(version_map):
+    entries = []
+    for module_path in _DD_TRACE_GO_MODULES:
+        entries.append('    "%s": "%s"' % (module_path, version_map[module_path]))
+    return "{\n  \"modules\": {\n%s\n  }\n}\n" % ",\n".join(entries)
